+      let ring = this.rings.get(s.id)
+      if (!ring) {
+        ring = new ScopeRing(RING_CAP)
+        this.rings.set(s.id, ring)
+      }
+      const n = ring.length
+      if (n > 0 && s.t < ring.timeAt(n - 1)) continue
+      ring.push(s.t, s.v)
+      if (s.t > this.newestT) this.newestT = s.t
+
+      let st = this.stats.get(s.id)
