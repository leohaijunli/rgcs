+/** Drop samples older than the window (relative to the newest sample). */
+function trimBuffer(b: Buffer, windowSec: number): void {
+  const n = b.t.length
+  if (n < 2) return
+  const cutoff = b.t[n - 1] - windowSec * 1000
+  let k = 0
+  while (k < n && b.t[k] < cutoff) k++
+  if (k > 0) {
+    b.t.splice(0, k)
+    b.raw.splice(0, k)
+    b.filtered.splice(0, k)
+  }
+}
